# ===========================================
# AI-Powered Jira Automation - Configuration
# ===========================================

# OpenAI API Key (required for AI processing)
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI Model (default: gpt-4o-mini for cost efficiency in POC)
OPENAI_MODEL=gpt-4o-mini

# Jira Configuration
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=SUP

# IMAP Configuration (for live inbox monitoring)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-email@gmail.com
IMAP_PASS=your-app-password
IMAP_TLS=true
IMAP_MAILBOX=INBOX
IMAP_POLL_INTERVAL_MS=30000

# Email Configuration (for auto-reply - optional for POC)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@company.com
SMTP_PASS=your-app-password

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
CONFIDENCE_THRESHOLD=0.7
AUTO_RESOLVE_ENABLED=true
